# Server runtime settings. Use .env.local for Next.js or .dev.vars for Cloudflare.
# Never commit secret keys. These variables are never sent to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAILS=info@mchf.org
# A random secret for anonymizing visitor identifiers; the Supabase secret is used if omitted.
ANALYTICS_SECRET=
# Optional canonical domain, e.g. https://www.mchf.org. Vercel supplies its domain automatically.
SITE_URL=
