# Server runtime settings. Use .dev.vars for the local Cloudflare preview.
# Never commit secret keys. These variables are never sent to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAILS=info@mchf.org
# A random secret for anonymizing visitor identifiers; the Supabase secret is used if omitted.
ANALYTICS_SECRET=
